    /// <summary>Starts Quake (once). The PAK files must be imported into table "Quake Pak File".</summary>
    procedure StartQuake()
    begin
        if QuakeStarted then
            exit;
        Initialize();
        InitQuakeRuntime();
        StackTop := SP;
        QuakeStarted := true;
        StartFailed := true;
        ResetLoopGuard(50000000, 60000); // a hang or a call that takes over a minute: an error with the call stack
        if not TryInit() then
            HandleAbort();
        StartFailed := false;
        StorePendingFiles();
    end;

    procedure IsStarted(): Boolean
    begin
        exit(QuakeStarted);
    end;

    /// <summary>True when the player quit Quake: the page should close.</summary>
    procedure IsQuitRequested(): Boolean
    begin
        exit(QuitRequested);
    end;

    /// <summary>Runs one Quake frame: game time advances by ElapsedMs (Quake runs at most 0.1 seconds per frame).</summary>
    procedure Frame(ElapsedMs: Integer)
    begin
        if (not QuakeStarted) or QuitRequested then
            exit;
        if ElapsedMs < 1 then
            ElapsedMs := 1;
        VirtualTime += ElapsedMs / 1000;
        ResetLoopGuard(50000000, 60000); // a hang or a call that takes over a minute: an error with the call stack
        if TryFrame(ElapsedMs) then
            ErrorsInARow := 0
        else
            HandleAbort();
        StorePendingFiles();
    end;

    /// <summary>A key event, with Quake's key number (keys.h: K_ENTER = 13, K_UPARROW = 128, K_MOUSE1 = 200, ...).</summary>
    procedure KeyEvent(QuakeKey: Integer; Down: Boolean)
    begin
        if (not QuakeStarted) or QuitRequested then
            exit;
        ResetLoopGuard(50000000, 60000); // a hang or a call that takes over a minute: an error with the call stack
        if not TryKey(QuakeKey, Down) then
            HandleAbort();
        StorePendingFiles();
    end;

    procedure MouseMove(DeltaX: Integer; DeltaY: Integer)
    begin
        if QuakeStarted then
            bc_mouse(DeltaX, DeltaY);
    end;

    [TryFunction]
    local procedure TryInit()
    begin
        bc_quake_init();
    end;

    [TryFunction]
    local procedure TryFrame(ElapsedMs: Integer)
    begin
        bc_quake_frame(ElapsedMs);
    end;

    [TryFunction]
    local procedure TryKey(QuakeKey: Integer; Down: Boolean)
    begin
        bc_key(QuakeKey, B2I(Down));
    end;

    // Host_Error, Host_EndGame and Sys_Quit end the C code with an AL error (they used longjmp):
    // the C stack is abandoned. Any other error (an overflow in a case the tests did not reach, ...) costs
    // the frame and is logged; Quake goes on unless it keeps failing or it happened while starting.
    local procedure HandleAbort()
    var
        Msg: Text;
        CallStack: Text;
        Tail: Text;
    begin
        SP := StackTop;
        Msg := GetLastErrorText();
        // where in the translated C code it happened (procedure names are the C function names)
        CallStack := GetLastErrorCallStack();
        ClearLastError();
        if FrameAborted or QuitRequested then begin
            FrameAborted := false;
            exit;
        end;
        ErrorsInARow += 1;
        Tail := CopyStr(LogText.ToText(), MaxInt(1, LogText.Length - 1000));
        LogText.Append('AL error: ' + Msg);
        LogText.AppendLine();
        LogText.Append(CopyStr(CallStack, 1, 2000));
        LogText.AppendLine();
        AddWarning('AL error: ' + Msg + ' in ' + CopyStr(CallStack, 1, 150));
        // a loop guard error means a hang: stop right away
        if StartFailed or (ErrorsInARow >= 10) or Msg.StartsWith('loop guard') then
            Error('Quake: %1\\%2\\Log:\%3', Msg, CopyStr(CallStack, 1, 2000), Tail);
    end;

    /// <summary>The 320x200 frame as palette indexes, base64.</summary>
    procedure GetFrame(): Text
    begin
        exit(EncodeBase64(bc_screen(), 64000));
    end;

    /// <summary>
    /// The rows of the 320x200 frame that changed since the previous call, base64 encoded.
    /// Each changed row is 321 bytes: the row number followed by 320 palette indexes.
    /// </summary>
    procedure GetFrameDelta(): Text
    var
        TB: TextBuilder;
        Row: array[321] of Integer;
        Scr: Integer;
        y: Integer;
        x: Integer;
        i: Integer;
        v: Integer;
        Base: Integer;
        Changed: Boolean;
    begin
        Scr := bc_screen();
        for y := 0 to 199 do begin
            Base := y * 320;
            Changed := false;
            for x := 1 to 320 do begin
                v := Mem.Get(Scr + Base + x);
                Row[x + 1] := v;
                if v <> PrevFrame[Base + x] then
                    Changed := true;
            end;
            if Changed then begin
                Row[1] := y;
                i := 1;
                while i <= 321 do begin
                    v := Row[i] * 65536 + Row[i + 1] * 256 + Row[i + 2];
                    TB.Append(B64Pair[v div 4096 + 1]);
                    TB.Append(B64Pair[v mod 4096 + 1]);
                    i += 3;
                end;
                for x := 1 to 320 do
                    PrevFrame[Base + x] := Row[x + 1];
            end;
        end;
        exit(TB.ToText());
    end;

    /// <summary>Makes the next GetFrameDelta / GetPaletteIfChanged send everything (e.g. after the screen was reloaded).</summary>
    procedure ResetFrameDelta()
    var
        i: Integer;
    begin
        for i := 1 to 64000 do
            PrevFrame[i] := -1;
        LastPalette := '';
    end;

    /// <summary>Returns the palette (256 RGB triples, base64) when it changed since the last call, otherwise empty text.</summary>
    procedure GetPaletteIfChanged(): Text
    var
        Pal: Text;
    begin
        Pal := EncodeBase64(bc_palette_rgb(), 768);
        if Pal = LastPalette then
            exit('');
        LastPalette := Pal;
        exit(Pal);
    end;

    /// <summary>The sound events since the previous call (see bc_sound), separated by '|'.</summary>
    procedure GetSoundEvents(): Text
    var
        Events: Text;
    begin
        Events := SoundEvents.ToText();
        Clear(SoundEvents);
        exit(Events);
    end;

    procedure GetQuakeLog(): Text
    begin
        exit(LogText.ToText());
    end;

    /// <summary>
    /// Times the operations the translated code is made of (per million, in milliseconds), to see where a frame's
    /// time goes in Business Central. Reads Mem but changes nothing.
    /// </summary>
    procedure RunBenchmark(): Text
    var
        Start: DateTime;
        Result: TextBuilder;
        i: Integer;
        j: Integer;
        s: Integer;
        d: Decimal;
        e: Decimal;
        b: BigInteger;
        Base: Integer;
    begin
        if not Initialized then
            exit('');
        Base := 4096;
        // 100,000 of each, shown as milliseconds per million
        Start := CurrentDateTime;
        for i := 1 to 100000 do
            s := Mem.Get(Base + i);
        Result.Append('ms per million: Mem.Get ' + PerMillion(Start));
        Start := CurrentDateTime;
        for i := 1 to 100000 do
            Mem.Set(Base + i, Mem.Get(Base + i));
        Result.Append(' | Get+Set ' + PerMillion(Start));
        Start := CurrentDateTime;
        for i := 1 to 100000 do
            s := ((i mod 8388608) + 8388608) mod 8388608 div 65536;
        Result.Append(' | int expr ' + PerMillion(Start));
        Start := CurrentDateTime;
        for i := 1 to 100000 do
            s := MaxInt(i, j);
        Result.Append(' | call ' + PerMillion(Start));
        Start := CurrentDateTime;
        d := 1.5;
        for i := 1 to 100000 do
            e := d * i + d;
        Result.Append(' | Decimal ' + PerMillion(Start));
        Start := CurrentDateTime;
        for i := 1 to 100000 do
            e := F32[Mem.Get(Base + i) * 2 + Mem.Get(Base + i) div 128 + 1] * ((Mem.Get(Base + i) mod 128) * 65536 + Mem.Get(Base + i) * 256 + Mem.Get(Base + i) + 8388608);
        Result.Append(' | float load ' + PerMillion(Start));
        if BenchScratch = 0 then
            BenchScratch := c2al_malloc(16);
        Start := CurrentDateTime;
        for i := 1 to 100000 do
            Rt_StoreF32(BenchScratch, i / 7);
        Result.Append(' | float store ' + PerMillion(Start));
        Start := CurrentDateTime;
        for i := 1 to 100000 do
            s := Rt_F2I(i / 7);
        Result.Append(' | Rt_F2I ' + PerMillion(Start));
        Start := CurrentDateTime;
        for i := 1 to 100000 do
            s := (i / 7) div 1;
        Result.Append(' | div 1 ' + PerMillion(Start));
        Start := CurrentDateTime;
        for i := 1 to 100000 do
            s := Rt_And(i, j);
        Result.Append(' | Rt_And ' + PerMillion(Start));
        Start := CurrentDateTime;
        for i := 1 to 100000 do
            b := (BZ + i) * 3;
        Result.Append(' | BigInteger ' + PerMillion(Start));
        // how this server's AL rounds negative values (C conversions need truncation toward zero)
        d := -2.5;
        e := -0.3;
        s := d div 1;
        Result.Append(StrSubstNo(' | AL: -2.5 div 1 = %1, Round(-0.3, 1, >) = %2, Round(-0.3, 1, <) = %3, Round(-2.5, 1) = %4, floor(-0.3) = %5, ceil(-0.3) = %6',
            s, Round(e, 1, '>'), Round(e, 1, '<'), Round(d, 1), Rt_Floor(e), Rt_Ceil(e)));
        exit(Result.ToText());
    end;

    local procedure PerMillion(Start: DateTime): Text
    var
        Ms: BigInteger;
    begin
        Ms := CurrentDateTime - Start;
        exit(Format(Ms * 10, 0, 9));
    end;

    // =====================================================================
    //  Runtime
    // =====================================================================

    local procedure InitQuakeRuntime()
    var
        B64Chars: Text;
        v: Integer;
    begin
        B64Chars := 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
        for v := 0 to 4095 do
            B64Pair[v + 1] := CopyStr(B64Chars, v div 64 + 1, 1) + CopyStr(B64Chars, v mod 64 + 1, 1);
        VirtualTime := 1;
        ResetFrameDelta();
    end;

    local procedure EncodeBase64(Addr: Integer; Len: Integer): Text
    var
        TB: TextBuilder;
        i: Integer;
        v: Integer;
        Full: Integer;
    begin
        Full := Len div 3 * 3;
        i := Addr + 1;
        while i <= Addr + Full do begin
            v := Mem.Get(i) * 65536 + Mem.Get(i + 1) * 256 + Mem.Get(i + 2);
            TB.Append(B64Pair[v div 4096 + 1]);
            TB.Append(B64Pair[v mod 4096 + 1]);
            i += 3;
        end;
        case Len - Full of
            1:
                begin
                    v := Mem.Get(i) * 65536;
                    TB.Append(B64Pair[v div 4096 + 1]);
                    TB.Append('==');
                end;
            2:
                begin
                    v := Mem.Get(i) * 65536 + Mem.Get(i + 1) * 256;
                    TB.Append(B64Pair[v div 4096 + 1]);
                    TB.Append(CopyStr(B64Pair[v mod 4096 + 1], 1, 1) + '=');
                end;
        end;
        exit(TB.ToText());
    end;

    local procedure MaxInt(a: Integer; b: Integer): Integer
    begin
        if a > b then
            exit(a);
        exit(b);
    end;

    local procedure MinInt(a: Integer; b: Integer): Integer
    begin
        if a < b then
            exit(a);
        exit(b);
    end;

