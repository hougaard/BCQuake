    end;

    // more loop iterations since ResetLoopGuard than the project option loop_guard allows: a C loop that hangs.
    // The error's call stack (GetLastErrorCallStack) names the C function
    local procedure Rt_LoopGuard()
    var
        Ms: Integer;
    begin
        LoopTotal += LoopGuard;
        LoopGuard := 0;
        if LoopMaxIterations > 0 then
            if LoopTotal > LoopMaxIterations then
                Error('loop guard: %1 loop iterations', LoopTotal);
        if LoopMaxMs > 0 then begin
            Ms := CurrentDateTime - LoopStart;
            if Ms > LoopMaxMs then
                Error('loop guard: running for %1 ms, %2 loop iterations', Ms, LoopTotal);
        end;
    end;

