    // ---- PAK files: table "Quake Pak File" has one record per file in the PAK, plus the header and the
    // directory as records of their own, so every byte of the original PAK file is in a record.

    local procedure bc_pak_open(name: Integer): Integer
    var
        Pak: Record "Quake Pak File";
        PakName: Text;
        Total: Integer;
    begin
        PakName := LowerCase(CStr(name));
        if PakNames.Contains(PakName) then
            exit(PakNames.IndexOf(PakName));
        Pak.SetRange("Pak Name", PakName);
        if Pak.IsEmpty() then
            exit(0);
        Pak.SetCurrentKey("Pak Name", "File Position");
        if Pak.FindLast() then
            Total := Pak."File Position" + Pak.Size;
        PakNames.Add(PakName);
        PakTotalSizes.Add(Total);
        exit(PakNames.Count());
    end;

    local procedure bc_pak_size(pak: Integer): Integer
    begin
        exit(PakTotalSizes.Get(pak));
    end;

    local procedure LoadPakDirectory(pak: Integer)
    var
        PakEntry: Record "Quake Pak File";
    begin
        if CurPak = pak then
            exit;
        Clear(EntryPos);
        Clear(EntryLen);
        Clear(EntryNo);
        PakEntry.SetCurrentKey("Pak Name", "File Position");
        PakEntry.SetRange("Pak Name", PakNames.Get(pak));
        PakEntry.SetLoadFields("Pak Name", "Entry No.", "File Position", Size);
        if PakEntry.FindSet() then
            repeat
                EntryPos.Add(PakEntry."File Position");
                EntryLen.Add(PakEntry.Size);
                EntryNo.Add(PakEntry."Entry No.");
            until PakEntry.Next() = 0;
        CurPak := pak;
        StreamEntry := 0;
    end;

    // index of the entry that contains pos, or of the first entry after pos (Count + 1 if none)
    local procedure FindEntry(pos: Integer): Integer
    var
        lo: Integer;
        hi: Integer;
        mid: Integer;
    begin
        lo := 1;
        hi := EntryPos.Count();
        while lo < hi do begin
            mid := (lo + hi + 1) div 2;
            if EntryPos.Get(mid) <= pos then
                lo := mid
            else
                hi := mid - 1;
        end;
        // (AL evaluates both sides of 'and': no Get before the count is checked)
        if lo > EntryPos.Count() then
            exit(lo);
        if EntryPos.Get(lo) > pos then
            exit(lo);
        if pos < EntryPos.Get(lo) + EntryLen.Get(lo) then
            exit(lo);
        exit(lo + 1);
    end;

    local procedure bc_pak_read(pak: Integer; pos: Integer; dest: Integer; count: Integer): Integer
    var
        Idx: Integer;
        Off: Integer;
        n: Integer;
        Total: Integer;
        i: Integer;
        b: Byte;
    begin
        LoadPakDirectory(pak);
        while count > 0 do begin
            Idx := FindEntry(pos);
            if Idx > EntryPos.Count() then
                exit(Total);
            if EntryPos.Get(Idx) > pos then begin
                // a gap between entries: zeros
                n := MinInt(count, EntryPos.Get(Idx) - pos);
                for i := dest + 1 to dest + n do
                    Mem.Set(i, 0);
            end else begin
                Off := pos - EntryPos.Get(Idx);
                n := MinInt(count, EntryLen.Get(Idx) - Off);
                if (Idx <> StreamEntry) or (Off < StreamPos) then begin
                    PakRecord.Get(PakNames.Get(pak), EntryNo.Get(Idx));
                    PakRecord.CalcFields(Data);
                    PakRecord.Data.CreateInStream(PakStream);
                    StreamEntry := Idx;
                    StreamPos := 0;
                end;
                while StreamPos < Off do begin
                    PakStream.Read(b);
                    StreamPos += 1;
                end;
                for i := dest + 1 to dest + n do begin
                    PakStream.Read(b);
                    Mem.Set(i, b);
                end;
                StreamPos += n;
            end;
            pos += n;
            dest += n;
            count -= n;
            Total += n;
        end;
        exit(Total);
    end;

    // ---- sound: the control add-in plays the WAV files, Quake reports what plays on its channels

    // info: samples, loop start (-1 = none), rate, width, channels of the WAV (computed when the PAK was imported)
    local procedure bc_sfx_info(name: Integer; info: Integer): Integer
    var
        Pak: Record "Quake Pak File";
    begin
        Pak.SetCurrentKey(Name);
        Pak.SetRange(Name, LowerCase(CStr(name)));
        Pak.SetLoadFields(Name, "Sample Count", "Loop Start", "Sample Rate", "Sample Width", Channels);
        if not Pak.FindLast() then
            exit(0);
        if Pak."Sample Rate" = 0 then
            exit(0);
        PokeInt(info, Pak."Sample Count");
        PokeInt(info + 4, Pak."Loop Start");
        PokeInt(info + 8, Pak."Sample Rate");
        PokeInt(info + 12, Pak."Sample Width");
        PokeInt(info + 16, Pak.Channels);
        exit(1);
    end;

    // n,sound,name: the WAV of a sound number (under sound/ in the PAK), sent before the sound's first start
    local procedure bc_sfx_name(sfx: Integer; name: Integer)
    begin
        AddSoundEvent('n,' + Format(sfx, 0, 9) + ',' + CStr(name));
    end;

    // s,channel,sound,left,right,loopstart = start (loop start in samples at 11025 Hz, -1 = no loop)
    // u,channel,left,right = volume change | x,channel = stop. Volumes are 0..255.
    local procedure bc_sound(kind: Integer; channel: Integer; sfx: Integer; left: Integer; right: Integer; arg: Integer)
    begin
        case kind of
            0:
                AddSoundEvent('s,' + Format(channel, 0, 9) + ',' + Format(sfx, 0, 9) + ',' + Format(left, 0, 9) + ',' + Format(right, 0, 9) + ',' + Format(arg, 0, 9));
            1:
                AddSoundEvent('u,' + Format(channel, 0, 9) + ',' + Format(left, 0, 9) + ',' + Format(right, 0, 9));
            2:
                AddSoundEvent('x,' + Format(channel, 0, 9));
        end;
    end;

    local procedure AddSoundEvent(EventText: Text)
    begin
        if SoundEvents.Length > 0 then
            SoundEvents.Append('|');
        SoundEvents.Append(EventText);
    end;

    // ---- user files: table "Quake User File", one record per user and file name

    local procedure bc_user_size(name: Integer): Integer
    var
        UserFile: Record "Quake User File";
        FileName: Text;
    begin
        FileName := LowerCase(CStr(name));
        if PendingNames.Contains(FileName) then
            exit(StrLen(PendingData.Get(PendingNames.IndexOf(FileName))));
        if not UserFile.Get(UserId(), FileName) then
            exit(-1);
        exit(UserFile.Size);
    end;

    local procedure bc_user_open(name: Integer; write: Integer): Integer
    var
        UserFile: Record "Quake User File";
        InS: InStream;
        Pending: Text;
        b: Byte;
        i: Integer;
    begin
        UserFileName := LowerCase(CStr(name));
        UserWriting := write <> 0;
        Clear(UserData);
        if UserWriting then
            exit(0);
        // a file written in this frame is not stored yet
        if PendingNames.Contains(UserFileName) then begin
            Pending := PendingData.Get(PendingNames.IndexOf(UserFileName));
            for i := 1 to StrLen(Pending) do
                UserData.Add(Pending[i]);
            exit(UserData.Count());
        end;
        if not UserFile.Get(UserId(), UserFileName) then
            exit(-1);
        UserFile.CalcFields(Data);
        UserFile.Data.CreateInStream(InS);
        for i := 1 to UserFile.Size do begin
            InS.Read(b);
            UserData.Add(b);
        end;
        exit(UserData.Count());
    end;

    local procedure bc_user_read(pos: Integer; dest: Integer; count: Integer): Integer
    var
        i: Integer;
    begin
        count := MinInt(count, UserData.Count() - pos);
        for i := 1 to count do
            Mem.Set(dest + i, UserData.Get(pos + i));
        exit(MaxInt(count, 0));
    end;

    local procedure bc_user_write(buf: Integer; count: Integer)
    var
        i: Integer;
    begin
        for i := 1 to count do
            UserData.Add(Mem.Get(buf + i));
    end;

    // a written file is kept as text (one character per byte) until StorePendingFiles stores it
    local procedure bc_user_close()
    var
        TB: TextBuilder;
        Ch: Char;
        i: Integer;
    begin
        if not UserWriting then
            exit;
        for i := 1 to UserData.Count() do begin
            Ch := UserData.Get(i);
            TB.Append(Ch);
        end;
        if PendingNames.Contains(UserFileName) then
            PendingData.Set(PendingNames.IndexOf(UserFileName), TB.ToText())
        else begin
            PendingNames.Add(UserFileName);
            PendingData.Add(TB.ToText());
        end;
        UserWriting := false;
        Clear(UserData);
    end;

    // stores the files written during the frame (not inside the TryFunction: no database writes there)
    local procedure StorePendingFiles()
    var
        UserFile: Record "Quake User File";
        OutS: OutStream;
        Content: Text;
        b: Byte;
        i: Integer;
        k: Integer;
        Exists: Boolean;
    begin
        for k := 1 to PendingNames.Count() do begin
            Content := PendingData.Get(k);
            Exists := UserFile.Get(UserId(), PendingNames.Get(k));
            if not Exists then begin
                UserFile.Init();
                UserFile."User ID" := CopyStr(UserId(), 1, MaxStrLen(UserFile."User ID"));
                UserFile.Name := CopyStr(PendingNames.Get(k), 1, MaxStrLen(UserFile.Name));
            end;
            UserFile.Data.CreateOutStream(OutS);
            for i := 1 to StrLen(Content) do begin
                b := Content[i];
                OutS.Write(b);
            end;
            UserFile.Size := StrLen(Content);
            UserFile."Modified At" := CurrentDateTime();
            if Exists then
                UserFile.Modify()
            else
                UserFile.Insert();
        end;
        Clear(PendingNames);
        Clear(PendingData);
    end;

    // =====================================================================
    //  Floating point (see docs/floats.md)
    //  C float and double values are AL Decimals. In Mem they are IEEE 754 bytes, so unions, memcpy
    //  and data read from files work as in C. A float load is inlined by the code generator:
    //      F32[sign * 256 + exponent + 1] * (mantissa + 2^23)
    //  Decimal has 28 decimal places and a range of +-7.9E28: smaller values become 0, larger ones are clamped.
    // =====================================================================

    local procedure InitFloat()
    var
        i: Integer;
        k: Integer;
        n: Integer;
        p: Integer;
    begin
        // P2[k + 151] = 2^k for k = -150..95
        P2[151] := 1;
        for k := 1 to 95 do
            P2[151 + k] := P2[150 + k] * 2;
        for k := 1 to 150 do
            P2[151 - k] := P2[152 - k] / 2;
        // F32[s * 256 + e + 1] = (-1)^s * 2^(e - 150): the value of one unit of the mantissa
        for i := 0 to 255 do begin
            k := i - 150;
            if i < 57 then
                k := -151
            else
                if k > 72 then
                    k := 72;
            if k < -150 then begin
                F32[i + 1] := 0;
                F32[i + 257] := 0;
            end else begin
                F32[i + 1] := P2[k + 151];
                F32[i + 257] := -P2[k + 151];
            end;
        end;
        // BitLen[i + 1] = number of significant bits of i
        n := 0;
        p := 1;
        BitLen[1] := 0;
        for i := 1 to 65535 do begin
            if i >= p then begin
                n += 1;
                p := p * 2;
            end;
            BitLen[i + 1] := n;
        end;
        D2p31 := 2147483647;
        D2p31 := D2p31 + 1;
    end;

    // floor(log2(v)) for v > 0
    local procedure FExp(v: Decimal): Integer
    var
        i: Integer;
        lo: Integer;
        hi: Integer;
        mid: Integer;
    begin
        if (v >= 1) and (v < D2p31) then begin
            i := v div 1;
            if i < 65536 then
                exit(BitLen[i + 1] - 1);
            exit(BitLen[i div 65536 + 1] + 15);
        end;
        lo := -150;
        hi := 95;
        while lo < hi do begin
            mid := (lo + hi + 1) div 2;
            if P2[mid + 151] <= v then
                lo := mid
            else
                hi := mid - 1;
        end;
        exit(lo);
    end;

    local procedure Rt_StoreF32(Addr: Integer; v: Decimal)
    var
        s: Integer;
        e: Integer;
        m: Integer;
        i: Integer;
    begin
        if v = 0 then begin
            Mem.Set(Addr + 1, 0);
            Mem.Set(Addr + 2, 0);
            Mem.Set(Addr + 3, 0);
            Mem.Set(Addr + 4, 0);
            exit;
        end;
        s := 0;
        if v < 0 then begin
            s := 128;
            v := -v;
        end;
        // biased exponent: 2^(e - 127) <= v < 2^(e - 126)
        if v >= 1 then begin
            if v < D2p31 then begin
                i := v div 1;
                if i < 65536 then
                    e := BitLen[i + 1] + 126
                else
                    e := BitLen[i div 65536 + 1] + 142;
            end else
                e := FExp(v) + 127;
        end else
            if v >= 0.0000152587890625 then begin
                i := (v * D2p31) div 1;
                if i < 65536 then
                    e := BitLen[i + 1] + 95
                else
                    e := BitLen[i div 65536 + 1] + 111;
            end else
                e := FExp(v) + 127;
        if e < 57 then begin
            // too small for Decimal: 0
            Mem.Set(Addr + 1, 0);
            Mem.Set(Addr + 2, 0);
            Mem.Set(Addr + 3, 0);
            Mem.Set(Addr + 4, 0);
            exit;
        end;
        if e > 254 then begin
            e := 254;
            m := 16777215;
        end else begin
            m := Round(v * P2[301 - e], 1);
            if m >= 16777216 then begin
                e += 1;
                m := 8388608;
            end;
        end;
        m := m - 8388608;
        Mem.Set(Addr + 1, m mod 256);
        Mem.Set(Addr + 2, (m div 256) mod 256);
        Mem.Set(Addr + 3, m div 65536 + (e mod 2) * 128);
        Mem.Set(Addr + 4, s + e div 2);
    end;

    local procedure Rt_LoadF64(Addr: Integer): Decimal
    var
        b6: Integer;
        b7: Integer;
        e: Integer;
        k: Integer;
        m: Decimal;
    begin
        b7 := Mem.Get(Addr + 8);
        b6 := Mem.Get(Addr + 7);
        e := (b7 mod 128) * 16 + b6 div 16;
        if e = 0 then
            exit(0);
        k := e - 1075;
        if k < -200 then
            exit(0);
        if k > 43 then
            k := 43;
        m := ((b6 mod 16) * 65536 + Mem.Get(Addr + 6) * 256 + Mem.Get(Addr + 5) + 1048576) * 4294967296.0 +
            Mem.Get(Addr + 4) * 16777216.0 + Mem.Get(Addr + 3) * 65536 + Mem.Get(Addr + 2) * 256 + Mem.Get(Addr + 1);
        // dividing by 2^-k (an exact integer) instead of multiplying by 2^k keeps the precision: Decimal has
        // 28 decimal places, so a small 2^k itself would only have a few significant digits
        if k >= 0 then
            m := m * P2[k + 151]
        else
            if k >= -95 then
                m := m / P2[151 - k]
            else
                m := m / P2[246] / P2[56 - k];
        if b7 >= 128 then
            exit(-m);
        exit(m);
    end;

    local procedure Rt_StoreF64(Addr: Integer; v: Decimal)
    var
        s: Integer;
        x: Integer;
        e: Integer;
        k: Integer;
        hi: Integer;
        lo1: Integer;
        lo0: Integer;
        m: Decimal;
        lo: Decimal;
        i: Integer;
    begin
        if v = 0 then begin
            for i := 1 to 8 do
                Mem.Set(Addr + i, 0);
            exit;
        end;
        s := 0;
        if v < 0 then begin
            s := 128;
            v := -v;
        end;
        x := FExp(v);
        k := 52 - x;
        if k > 95 then
            m := Round(v * P2[246] * P2[k + 56], 1)
        else
            m := Round(v * P2[k + 151], 1);
        if m >= 9007199254740992.0 then begin
            x += 1;
            m := 4503599627370496.0;
        end;
        e := x + 1023;
        m := m - 4503599627370496.0;
        hi := m div 4294967296.0;
        lo := m - hi * 4294967296.0;
        lo1 := lo div 65536;
        // (lo1 * 65536 as Integer would overflow for lo1 >= 32768)
        lo0 := (lo - lo1 * 65536.0) div 1;
        Mem.Set(Addr + 1, lo0 mod 256);
        Mem.Set(Addr + 2, lo0 div 256);
        Mem.Set(Addr + 3, lo1 mod 256);
        Mem.Set(Addr + 4, lo1 div 256);
        Mem.Set(Addr + 5, hi mod 256);
        Mem.Set(Addr + 6, (hi div 256) mod 256);
        Mem.Set(Addr + 7, hi div 65536 + (e mod 16) * 16);
        Mem.Set(Addr + 8, s + e div 16);
    end;

    // a / b. C gives +-inf or nan when b is 0, AL raises an error: return a large value instead
    local procedure Rt_FDiv(a: Decimal; b: Decimal): Decimal
    begin
        if b = 0 then begin
            if a > 0 then
                exit(100000000000000000000.0);
            if a < 0 then
                exit(-100000000000000000000.0);
            exit(0);
        end;
        exit(a / b);
    end;

    // C cast to int: truncates toward zero. Out of range values give 0x80000000 like x86 (AL would raise an error)
    local procedure Rt_F2I(x: Decimal): Integer
    begin
        if (x < D2p31) and (x > -D2p31 - 1) then
            exit(x div 1);
        exit(-2147483647 - 1);
    end;

    // unsigned int -> double
    local procedure Rt_U2D(a: Integer): Decimal
    begin
        if a >= 0 then
            exit(a);
        exit(a + 4294967296.0);
    end;

    local procedure Rt_Sqrt(x: Decimal): Decimal
    begin
        if x <= 0 then
            exit(0);
        exit(Power(x, 0.5));
    end;

    // floor and ceil without Round's '<' / '>' directions, whose meaning for negative values (toward -infinity or
    // away from zero) is not what C needs in every case: round to the nearest integer and correct it
    local procedure Rt_Floor(x: Decimal): Decimal
    var
        r: Decimal;
    begin
        r := Round(x, 1);
        if r > x then
            r -= 1;
        exit(r);
    end;

    local procedure Rt_Ceil(x: Decimal): Decimal
    var
        r: Decimal;
    begin
        r := Round(x, 1);
        if r < x then
            r += 1;
        exit(r);
    end;

    local procedure Rt_FAbs(x: Decimal): Decimal
    begin
        exit(Abs(x));
    end;
    
    // mathlib.c:292
    local procedure AngleVectors(angles_2: Integer; forward: Integer; right: Integer; up: Integer)
    var
        angle: Decimal;
        sr: Decimal;
        sp_2: Decimal;
        sy: Decimal;
        cr: Decimal;
        cp: Decimal;
        cy: Decimal;
    begin
        angle := (F32[Mem.Get(angles_2 + 8) * 2 + Mem.Get(angles_2 + 7) div 128 + 1] * ((Mem.Get(angles_2 + 7) mod 128) * 65536 + Mem.Get(angles_2 + 6) * 256 + Mem.Get(angles_2 + 5) + 8388608)) * 0.017453292519943295;
        sy := Rt_Sin(angle);
        cy := Rt_Cos(angle);
        angle := (F32[Mem.Get(angles_2 + 4) * 2 + Mem.Get(angles_2 + 3) div 128 + 1] * ((Mem.Get(angles_2 + 3) mod 128) * 65536 + Mem.Get(angles_2 + 2) * 256 + Mem.Get(angles_2 + 1) + 8388608)) * 0.017453292519943295;
        sp_2 := Rt_Sin(angle);
        cp := Rt_Cos(angle);
        angle := (F32[Mem.Get(angles_2 + 12) * 2 + Mem.Get(angles_2 + 11) div 128 + 1] * ((Mem.Get(angles_2 + 11) mod 128) * 65536 + Mem.Get(angles_2 + 10) * 256 + Mem.Get(angles_2 + 9) + 8388608)) * 0.017453292519943295;
        sr := Rt_Sin(angle);
        cr := Rt_Cos(angle);
        Rt_StoreF32(forward, cp * cy);
        Rt_StoreF32(forward + 4, cp * sy);
        Rt_StoreF32(forward + 8, -sp_2);
        Rt_StoreF32(right, ((((-1.0) * sr) * sp_2) * cy) + (((-1.0) * cr) * (-sy)));
        Rt_StoreF32(right + 4, ((((-1.0) * sr) * sp_2) * sy) + (((-1.0) * cr) * cy));
        Rt_StoreF32(right + 8, ((-1.0) * sr) * cp);
        Rt_StoreF32(up, ((cr * sp_2) * cy) + ((-sr) * (-sy)));
        Rt_StoreF32(up + 4, ((cr * sp_2) * sy) + ((-sr) * cy));
        Rt_StoreF32(up + 8, cr * cp);
    end;
    
